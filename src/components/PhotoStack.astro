---
// one photo per screen with a wall-label caption; used by trip, collection and exhibit pages
import { Image } from 'astro:assets';
import type { Photo } from '../lib/photos';

interface Props { photos: Photo[] }
const { photos } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

{photos.map((p, i) => (
  <figure id={pad(i + 1)} class="photo">
    <Image src={p.image} alt={p.title} widths={[800, 1200, 1600, 2400]} sizes="(max-width: 960px) 100vw, 960px" loading={i === 0 ? 'eager' : 'lazy'} />
    <figcaption class="mono">
      <span>{pad(i + 1)}</span>
      <span>{p.title}</span>
      <span>{p.place ?? '—'}</span>
      <span>{p.date ?? p.year ?? '—'}</span>
      <span>{p.camera ?? '—'}</span>
    </figcaption>
  </figure>
))}
