---
import '@fontsource-variable/jost';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
}

const NAME = 'oneash';
const TAGLINE = 'building digital things in a digital world.';
const NAV = [
  { href: '/research', label: 'research' },
  { href: '/photography', label: 'photography' },
  { href: '/cartography', label: 'cartography' },
  { href: '/app-dev', label: 'app dev' },
];

// staggered title move: each letter is its own view-transition group, delayed by its index
const TITLE_VT_CSS =
  [...NAME].map((_, i) => `::view-transition-group(title-${i}),::view-transition-old(title-${i}),::view-transition-new(title-${i}){animation-delay:calc(var(--vt-fade) + ${i} * var(--vt-stagger))}`).join('') +
  `:root{--vt-title-chars:${[...NAME].length}}`;

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const isHome = path === '';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${NAME}` : NAME}</title>
    <meta name="description" content={TAGLINE} />
    <!-- start font downloads right away instead of after CSS parses; title font is subset to Latin letters only, re-run pyftsubset if NAME gains other glyphs -->
    <link rel="preload" href="/fonts/AlteHaasGroteskBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Tamzen7x14r.woff2" as="font" type="font/woff2" crossorigin />
    <!-- in-page view transitions; native cross-document ones flicker in Arc -->
    <ClientRouter />
    <style is:inline set:html={TITLE_VT_CSS}></style>
  </head>
  <body>
    <!-- grain for the site title; raise intercept (max 1) for less noise, lower it for more -->
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <filter id="grain">
        <feTurbulence type="fractalNoise" baseFrequency="1.4" numOctaves="2" stitchTiles="stitch" result="noise" />
        <feColorMatrix in="noise" type="saturate" values="0" result="mono" />
        <feComponentTransfer in="mono" result="soft">
          <feFuncR type="linear" slope="0.8" intercept="0.2" />
          <feFuncG type="linear" slope="0.8" intercept="0.2" />
          <feFuncB type="linear" slope="0.8" intercept="0.2" />
        </feComponentTransfer>
        <feComposite in="soft" in2="SourceGraphic" operator="in" result="masked" />
        <feBlend in="SourceGraphic" in2="masked" mode="multiply" />
      </filter>
    </svg>
    <main>
      <header>
        <slot name="hero" />
        <h1><a href="/" aria-label={NAME}>{[...NAME].map((ch, i) => <span aria-hidden="true" style={`--i: ${i}; view-transition-name: title-${i}`}>{ch}</span>)}</a></h1>
        <p class="caption">{TAGLINE}<em class="tagline-sub">(and sometimes analog things too)</em></p>
        {/* homepage: menu folds behind a toggle; other pages: always open */}
        {isHome && <button class="nav-toggle" type="button" aria-expanded="true" aria-controls="site-nav">menu</button>}
        <div class="nav-wrap" id="site-nav">
          <nav aria-label="Sections">
            {NAV.map((n) => <a href={n.href} aria-current={path === n.href || path.startsWith(n.href + '/') ? 'page' : undefined}>{n.label}</a>)}
          </nav>
        </div>
        {isHome && (
          <script is:inline data-astro-rerun>
            // collapse before first paint; without JS the menu just stays open. data-astro-rerun: ClientRouter would otherwise skip it after the first visit
            (() => {
              const btn = document.querySelector('.nav-toggle');
              const wrap = document.getElementById('site-nav');
              const set = (open) => { btn.setAttribute('aria-expanded', open); wrap.inert = !open; };
              set(false);
              btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
            })();
          </script>
        )}
      </header>

      <slot />

    </main>
  </body>
</html>
