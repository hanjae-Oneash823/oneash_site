---
// /photography/trips/<slug>, /photography/collections/<slug> (exhibits have their own page)
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PhotoStack from '../../../components/PhotoStack.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { getLibrary, resolvePhotos, type Photo } from '../../../lib/photos';

export async function getStaticPaths() {
  const { trips, all } = await getLibrary();
  const collections = await getCollection('photoCollections');
  return [
    ...trips.map((t) => ({
      params: { kind: 'trips', slug: t.slug },
      props: { title: t.name, meta: t.year ? String(t.year) : undefined, photos: t.photos },
    })),
    ...collections.map((c) => ({
      params: { kind: 'collections', slug: c.id },
      props: { title: c.data.title, photos: resolvePhotos(c.data.photos, all, `src/content/collections/${c.id}.md`), entry: c },
    })),
  ];
}

interface Props {
  title: string;
  meta?: string;
  photos: Photo[];
  entry?: CollectionEntry<'photoCollections'>;
}
const { kind } = Astro.params;
const { title, meta, photos, entry } = Astro.props;
const Body = entry && (await render(entry)).Content;
---

<Base title={title}>
  <section class="photo-series">
    <p class="series-head mono"><a href="/photography">photography</a> / {kind} / <span>{title}</span>{meta && ` · ${meta}`}</p>
    {Body && <div class="series-text"><Body /></div>}
    {photos.length === 0 && <p class="mono series-empty">no photos yet.</p>}
    <PhotoStack photos={photos} />
  </section>
  <Lightbox />
</Base>
