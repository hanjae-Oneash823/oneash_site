---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getPhotos } from '../lib/photos';

const LIGHTBOX_WIDTH = 2400;
const fmt = (d: Date) => d.toISOString().slice(0, 10);

const photos = await getPhotos();
const lightbox = await Promise.all(photos.map((p) => getImage({ src: p.image, width: LIGHTBOX_WIDTH })));
---

<Base title="Photography">
  <section>
    <h2>Photography</h2>
    <p class="caption">click any frame to view it larger.</p>
    {photos.length === 0 && <p class="mono">no photos yet: npm run add-photos ~/path/to/folder</p>}
    <div class="grid">
      {photos.map((p, i) => (
        <a
          href={lightbox[i].src}
          data-caption={[p.camera, p.settings, p.taken && fmt(p.taken)].filter(Boolean).join('  ·  ')}
        >
          <Image src={p.image} alt={p.name} widths={[400, 800, 1200]} sizes="(max-width: 700px) 100vw, 33vw" loading="lazy" />
        </a>
      ))}
    </div>
  </section>

  <dialog id="lightbox">
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#lightbox')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;
  document.querySelectorAll<HTMLAnchorElement>('.grid a').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
      caption.textContent = a.dataset.caption ?? '';
      dialog.showModal();
    });
  });
  dialog.addEventListener('click', () => dialog.close()); // Esc closes natively
</script>
