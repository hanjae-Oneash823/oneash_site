---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import homePhoto from '../photos/2023 Iceland/2. (80X40) Mountains over Vík, Iceland, 2023.jpg';

const CONTACT = [
  { label: 'github', href: 'https://github.com/hanjae-Oneash823', text: 'hanjae-Oneash823' },
  { label: 'email', href: 'mailto:hanjae_kim@hotmail.com', text: 'hanjae_kim@hotmail.com' },
  { label: 'instagram', href: 'https://www.instagram.com/o._.neash/', text: '@o._.neash' },
];
---

<Base>
  <Image slot="hero" class="home-photo" src={homePhoto} alt="Mountains over Vík, Iceland, 2023" widths={[420, 840, 1260]} sizes="(max-width: 700px) 100vw, 420px" />
  <div class="home">
  <div class="intro">
    <p>hi, i'm Hanjae. i'm an undergrad studying life sciences in Korea. i do research in functional genomics, mainly on splicing isoforms.</p>
    <p>in my spare time i take photos, usually on a Nikon Zfc or a Canonet QL17. i also draw maps, and i drive to the beach on weekends.</p>
    <p>this site is a small collection of things i've made over the years. most of them are digital and some are analog. feel free to reach out about anything. i'll get back to you as soon as i can.</p>
    <ul class="links mono">
      {CONTACT.map((c) => <li>{c.label}: <a href={c.href} data-copy={c.href.startsWith('mailto:') ? c.text : undefined}>{c.text}</a></li>)}
    </ul>
    <footer class="mono">© {new Date().getFullYear()} Hanjae Kim</footer>
  </div>
  </div>
</Base>

<script>
  const COPIED_MS = 1500;
  document.querySelectorAll<HTMLAnchorElement>('a[data-copy]').forEach((a) => {
    const original = a.textContent;
    a.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(a.dataset.copy!);
        a.textContent = 'copied!';
      } catch {
        window.location.href = a.href; // clipboard blocked: fall back to mail app
        return;
      }
      setTimeout(() => (a.textContent = original), COPIED_MS);
    });
  });
</script>
